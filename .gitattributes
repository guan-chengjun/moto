# 默认：由 git 自动判断文本/二进制，文本按仓库内 LF 存储
* text=auto eol=lf

# 明确文本类型
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.js       text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.py      text eol=lf
*.java    text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.cs      text eol=lf
*.go      text eol=lf
*.rs      text eol=lf
*.sh      text eol=lf
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.json5   text eol=lf

# Windows 专用脚本保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf

# 明确二进制资源，不参与文本 diff / 合并
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.bmp     binary
*.tga     binary
*.psd     binary
*.webp    binary
*.ico     binary
*.svg     text
*.mp3     binary
*.wav     binary
*.ogg     binary
*.flac    binary
*.mp4     binary
*.mov     binary
*.webm    binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.zip     binary
*.7z      binary
*.unity   binary
*.asset   binary
*.uasset  binary
*.umap    binary
*.pak     binary

# 让 git 识别 Git LFS 管理的路径（启用 LFS 后生效）
*.psd   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
